# ===========================================
# Next-Forge 环境变量配置
# ===========================================
#
# 本 monorepo 采用分布式 .env.example 文件结构
# 每个包和应用都有独立的 .env.example，包含详细说明
#
# 包配置文件:
#   packages/ai/.env.example            - OpenAI (AI 功能)
#   packages/analytics/.env.example     - PostHog, Google Analytics (数据分析)
#   packages/auth/.env.example          - Better Auth (用户认证)
#   packages/cms/.env.example           - Basehub (内容管理)
#   packages/collaboration/.env.example - Liveblocks (实时协作)
#   packages/database/.env.example      - PostgreSQL (数据库)
#   packages/email/.env.example         - Resend (邮件服务)
#   packages/feature-flags/.env.example - Feature Flags (特性开关)
#   packages/next-config/.env.example   - URLs, Vercel (基础配置)
#   packages/notifications/.env.example - Knock (通知服务)
#   packages/observability/.env.example - BetterStack, Sentry (可观测性)
#   packages/payments/.env.example      - Stripe (支付)
#   packages/rate-limit/.env.example    - Upstash Redis (速率限制)
#   packages/security/.env.example      - Arcjet (安全防护)
#   packages/storage/.env.example       - Cloudflare R2 (文件存储)
#   packages/trigger/.env.example       - Trigger.dev (后台任务)
#   packages/webhooks/.env.example      - Svix (Webhook)
#
# 应用配置文件 (组合自各个包):
#   apps/app/.env.example - 主应用
#   apps/api/.env.example - API 服务
#
# ===========================================

# ============ 核心配置 (必填) ============

# [必填] PostgreSQL 数据库连接字符串
# 应用的核心数据存储，不填写将导致应用无法启动
DATABASE_URL=postgresql://user:password@localhost:5432/nextforge

# [必填] Better Auth 会话密钥（至少 16 个字符）
# 用于加密和签名用户会话
BETTER_AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [可选] 应用基础 URL
# 不填写后果：邮件验证链接、OAuth 回调等功能可能异常，生产环境强烈建议填写
BETTER_AUTH_URL=http://localhost:3000

# [必填] 应用 URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3001

# [可选] 其他服务 URLs
# 不填写后果：相关链接跳转不可用
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_DOCS_URL=http://localhost:3004

# ============ 邮件服务 (必填) ============

# [必填] Resend 发件人和 API Token
# 不填写后果：所有邮件功能不可用（验证码、通知等）
RESEND_FROM=onboarding@resend.dev
RESEND_TOKEN=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ 支付服务 ============

# [必填] Stripe 密钥（如需支付功能）
# 不填写后果：所有支付功能不可用
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [可选] Stripe Webhook 密钥
# 不填写后果：无法接收支付回调，订阅状态更新等功能异常
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ 可选服务 ============

# --- 数据分析 ---

# [可选] PostHog 产品分析
# 不填写后果：用户行为分析、漏斗分析、A/B 测试等功能不可用
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# [可选] Google Analytics
# 不填写后果：GA 数据追踪不可用
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- 可观测性 ---

# [可选] BetterStack 日志
# 不填写后果：结构化日志不会发送到云端，无法远程查看和搜索日志
BETTERSTACK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BETTERSTACK_URL=https://in.logs.betterstack.com

# --- 特性开关 ---

# [可选] 特性开关密钥
# 不填写后果：灰度发布、A/B 测试功能不可用
FLAGS_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 安全防护 ---

# [可选] Arcjet API 密钥
# 不填写后果：Bot 检测、速率限制、邮箱验证等安全功能不可用
ARCJET_KEY=ajkey_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Webhooks ---

# [可选] Svix Token
# 不填写后果：Webhook 发送和管理功能不可用
SVIX_TOKEN=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 实时协作 ---

# [可选] Liveblocks 密钥
# 不填写后果：实时协作功能不可用（多人光标、实时编辑、在线状态等）
LIVEBLOCKS_SECRET=sk_dev_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 内容管理 ---

# [必填] Basehub API Token（如需 CMS 功能）
# 不填写后果：无法从 Basehub 获取内容
BASEHUB_TOKEN=bshb_pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 通知服务 ---

# [可选] Knock 通知服务
# 不填写后果：应用内通知、推送通知功能不可用
KNOCK_SECRET_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_KNOCK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_KNOCK_FEED_CHANNEL_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 速率限制 ---

# [可选] Upstash Redis（用于速率限制）
# 不填写后果：基于 Redis 的速率限制不可用，API 无法防护暴力攻击
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- AI 功能 ---

# [可选] OpenAI API 密钥
# 不填写后果：AI 相关功能不可用（聊天、文本生成等）
OPENAI_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 后台任务 ---

# [必填] Trigger.dev API 密钥（如需后台任务功能）
# 不填写后果：所有异步任务、定时任务功能不可用
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- 文件存储 ---

# [必填] Cloudflare R2 配置（如需文件存储功能）
# 不填写后果：文件上传、存储功能不可用
CLOUDFLARE_R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_BUCKET=your-bucket-name

# [可选] R2 端点地址
# 不填写后果：使用默认端点 https://{account_id}.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# [可选] 文件公开访问 URL
# 不填写后果：上传的文件需要通过签名 URL 访问，无法直接公开访问
NEXT_PUBLIC_CLOUDFLARE_R2_URL=https://your-bucket.your-domain.com

# --- 国际化 ---

# [可选] Languine 项目 ID
# 不填写后果：自动翻译功能不可用
LANGUINE_PROJECT_ID=

# Fal AI 包环境变量

# [可选] Fal AI API 密钥
# 获取地址: https://fal.ai/dashboard/keys
# 不填写后果：无法使用 Fal AI API
FAL_KEY=your-fal-api-key