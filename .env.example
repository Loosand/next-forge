# ===========================================
# Shared Environment Variables (Root Level)
# ===========================================
# These variables are shared across all apps (app, api, web)
# Each app can override these in their own .env file

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nextforge"
REDIS_URL="redis://"

# Auth (Better Auth)
BETTER_AUTH_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
BETTER_AUTH_URL="http://localhost:3000"  # Production: https://app.yourdomain.com

# Email (Resend)
RESEND_FROM="onboarding@resend.dev"
RESEND_TOKEN="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Payments (Stripe)
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Observability (BetterStack)
BETTERSTACK_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
BETTERSTACK_URL="https://in.logs.betterstack.com"

# Feature Flags
FLAGS_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Security (Arcjet)
ARCJET_KEY="ajkey_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Webhooks (Svix)
SVIX_TOKEN="sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Collaboration (Liveblocks)
LIVEBLOCKS_SECRET="sk_dev_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# CMS (Basehub)
BASEHUB_TOKEN="bshb_pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Notifications (Knock)
KNOCK_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
KNOCK_FEED_CHANNEL_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
KNOCK_SECRET_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Analytics (Client)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Notifications (Client)
NEXT_PUBLIC_KNOCK_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_KNOCK_FEED_CHANNEL_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# URLs (Client)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3002"
NEXT_PUBLIC_DOCS_URL="http://localhost:3004"

# i18n
LANGUINE_PROJECT_ID=

# Trigger.dev
TRIGGER_SECRET_KEY=

# Blob
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
NEXT_PUBLIC_CLOUDFLARE_R2_URL=