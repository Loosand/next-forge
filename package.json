{
  "name": "next-forge",
  "version": "5.3.2",
  "bin": {
    "next-forge": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=!docs --filter=!@repo/cms --filter=!storybook --ui=stream",
    "check": "bunx ultracite@latest check",
    "fix": "bunx ultracite@latest fix",
    "test": "turbo test",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "bump-deps": "bunx npm-check-updates --deep -u -x recharts && bun install",
    "bump-ui": "bunx shadcn@latest add --all --overwrite -c packages/design-system",
    "db:generate": "cd packages/database && bun run generate",
    "db:migrate": "cd packages/database && bun run migrate",
    "db:push": "cd packages/database && bun run push",
    "db:studio": "cd packages/database && bun run studio",
    "clean": "git clean -xdf node_modules"
  },
  "devDependencies": {
    "@auto-it/first-time-contributor": "^11.3.6",
    "@biomejs/biome": "2.3.8",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.17",
    "@turbo/gen": "^2.7.2",
    "@types/node": "^24.10.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tsup": "^8.5.1",
    "turbo": "^2.7.2",
    "typescript": "^5.9.3",
    "ultracite": "6.3.9",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.2"
  },
  "overrides": {
    "parse5": "^7.2.1",
    "next": "16.0.10"
  },
  "type": "module"
}
