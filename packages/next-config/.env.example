# Next Config 配置包环境变量

# [可选] 打包分析开关
# 不填写后果：无法查看打包体积分析报告
ANALYZE=false

# [必填] 主应用 URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [必填] 营销网站 URL
NEXT_PUBLIC_WEB_URL=http://localhost:3001

# [可选] API 服务 URL
# 不填写后果：如果应用需要调用独立的 API 服务，相关功能将不可用
NEXT_PUBLIC_API_URL=http://localhost:3002

# [可选] 文档站点 URL
# 不填写后果：文档链接跳转将不可用
NEXT_PUBLIC_DOCS_URL=http://localhost:3004

# 以下由 Vercel 自动设置，无需手动填写
# VERCEL=
# VERCEL_ENV=
# VERCEL_URL=
# VERCEL_REGION=
# VERCEL_PROJECT_PRODUCTION_URL=
