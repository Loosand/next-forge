# Observability 可观测性包环境变量

# [可选] BetterStack 日志 API 密钥
# 不填写后果：结构化日志不会发送到 BetterStack，无法在云端查看和搜索日志
BETTERSTACK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [可选] BetterStack 日志接收地址
# 不填写后果：同上，日志无法发送到 BetterStack
BETTERSTACK_URL=https://in.logs.betterstack.com

# [可选] Sentry 组织名称（通常由 Vercel Marketplace 自动设置）
# 不填写后果：错误上报配置不完整
SENTRY_ORG=

# [可选] Sentry 项目名称（通常由 Vercel Marketplace 自动设置）
# 不填写后果：错误上报配置不完整
SENTRY_PROJECT=

# [可选] Sentry DSN 地址
# 不填写后果：前端错误追踪不可用，无法在 Sentry 后台看到错误报告
NEXT_PUBLIC_SENTRY_DSN=
