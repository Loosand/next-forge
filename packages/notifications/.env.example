# Notifications 通知包环境变量 (Knock)

# [可选] Knock 服务端密钥
# 不填写后果：服务端推送通知功能不可用
KNOCK_SECRET_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [可选] Knock 客户端公钥
# 不填写后果：前端通知组件无法连接 Knock 服务
NEXT_PUBLIC_KNOCK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [可选] Knock 消息通道 ID
# 不填写后果：应用内通知 Feed 功能不可用
NEXT_PUBLIC_KNOCK_FEED_CHANNEL_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
