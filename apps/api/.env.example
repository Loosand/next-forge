# ===========================================
# API 应用环境变量
# ===========================================
# 本应用依赖: auth, analytics, core, database, email, observability, payments

# ============ Auth 认证 (Better Auth) ============

# [必填] 会话令牌签名密钥（至少 16 个字符）
BETTER_AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [可选] 应用基础 URL
# 不填写后果：邮件验证链接、OAuth 回调等功能可能异常
BETTER_AUTH_URL=http://localhost:3000

# ============ Analytics 分析 ============

# [可选] PostHog 产品分析
# 不填写后果：用户行为分析功能不可用
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# [可选] Google Analytics
# 不填写后果：GA 数据追踪不可用
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============ Next Config URLs ============

# [必填] 主应用 URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [必填] 营销网站 URL
NEXT_PUBLIC_WEB_URL=http://localhost:3001

# [可选] API 服务 URL
NEXT_PUBLIC_API_URL=http://localhost:3002

# [可选] 文档站点 URL
NEXT_PUBLIC_DOCS_URL=http://localhost:3004

# ============ Database 数据库 ============

# [必填] PostgreSQL 连接字符串
DATABASE_URL=postgresql://user:password@localhost:5432/nextforge

# ============ Email 邮件 (Resend) ============

# [必填] 发件人邮箱
RESEND_FROM=onboarding@resend.dev

# [必填] Resend API Token
RESEND_TOKEN=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ Observability 可观测性 ============

# [可选] BetterStack 日志
# 不填写后果：云端日志功能不可用
BETTERSTACK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BETTERSTACK_URL=https://in.logs.betterstack.com

# [可选] Sentry 错误追踪（通常由 Vercel 自动设置）
# SENTRY_ORG=
# SENTRY_PROJECT=
# NEXT_PUBLIC_SENTRY_DSN=

# ============ Payments 支付 (Stripe) ============

# [必填] Stripe 密钥
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [可选] Stripe Webhook 密钥
# 不填写后果：无法接收支付回调通知
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
