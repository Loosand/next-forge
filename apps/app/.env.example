# ===========================================
# 主应用环境变量
# ===========================================
# 本应用依赖: auth, analytics, collaboration, core, database, email,
#            flags, notifications, observability, rateLimit, security, storage, webhooks

# ============ Auth 认证 (Better Auth) ============

# [必填] 会话令牌签名密钥（至少 16 个字符）
BETTER_AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [可选] 应用基础 URL
# 不填写后果：邮件验证链接、OAuth 回调等功能可能异常
BETTER_AUTH_URL=http://localhost:3000

# ============ Analytics 分析 ============

# [可选] PostHog 产品分析
# 不填写后果：用户行为分析功能不可用
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# [可选] Google Analytics
# 不填写后果：GA 数据追踪不可用
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============ Collaboration 协作 (Liveblocks) ============

# [可选] Liveblocks 密钥
# 不填写后果：实时协作功能不可用（多人光标、实时编辑等）
LIVEBLOCKS_SECRET=sk_dev_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ Next Config URLs ============

# [必填] 主应用 URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [必填] 营销网站 URL
NEXT_PUBLIC_WEB_URL=http://localhost:3001

# [可选] API 服务 URL
NEXT_PUBLIC_API_URL=http://localhost:3002

# [可选] 文档站点 URL
NEXT_PUBLIC_DOCS_URL=http://localhost:3004

# ============ Database 数据库 ============

# [必填] PostgreSQL 连接字符串
DATABASE_URL=postgresql://user:password@localhost:5432/nextforge

# ============ Email 邮件 (Resend) ============

# [必填] 发件人邮箱
RESEND_FROM=onboarding@resend.dev

# [必填] Resend API Token
RESEND_TOKEN=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ Feature Flags 特性开关 ============

# [可选] 特性开关密钥
# 不填写后果：灰度发布、A/B 测试功能不可用
FLAGS_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ Notifications 通知 (Knock) ============

# [可选] Knock 服务端密钥
# 不填写后果：服务端推送通知不可用
KNOCK_SECRET_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [可选] Knock 客户端配置
# 不填写后果：前端通知组件不可用
NEXT_PUBLIC_KNOCK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_KNOCK_FEED_CHANNEL_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ Observability 可观测性 ============

# [可选] BetterStack 日志
# 不填写后果：云端日志功能不可用
BETTERSTACK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BETTERSTACK_URL=https://in.logs.betterstack.com

# [可选] Sentry 错误追踪（通常由 Vercel 自动设置）
# SENTRY_ORG=
# SENTRY_PROJECT=
# NEXT_PUBLIC_SENTRY_DSN=

# ============ Rate Limit 速率限制 (Upstash Redis) ============

# [可选] Upstash Redis 配置
# 不填写后果：API 速率限制功能不可用，无法防护暴力攻击
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ Security 安全 (Arcjet) ============

# [可选] Arcjet API 密钥
# 不填写后果：Bot 检测、安全防护功能不可用
ARCJET_KEY=ajkey_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============ Storage 存储 (Cloudflare R2) ============

# [必填] Cloudflare R2 配置（如需文件存储功能）
CLOUDFLARE_R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_BUCKET=your-bucket-name

# [可选] R2 端点地址
# 不填写后果：使用默认端点
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# [可选] 文件公开访问 URL
# 不填写后果：文件需通过签名 URL 访问
NEXT_PUBLIC_CLOUDFLARE_R2_URL=https://your-bucket.your-domain.com

# ============ Webhooks (Svix) ============

# [可选] Svix Token
# 不填写后果：Webhook 推送功能不可用
SVIX_TOKEN=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
